<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />
        <Button
            android:id="@+id/licensesButton" style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:text="@string/licenses" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/preview_background">
            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
            <org.garbageclassifier.camera.DetectionOverlay
                android:id="@+id/overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <ScrollView
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioGroup
                    android:id="@+id/modeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:checkedButton="@id/scannerButton">
                    <RadioButton
                        android:id="@+id/scannerButton" style="@style/Segment"
                        android:text="@string/scanner" />
                    <RadioButton
                        android:id="@+id/inspectionButton" style="@style/Segment"
                        android:text="@string/inspection" />
                </RadioGroup>
                <RadioGroup
                    android:id="@+id/binGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:checkedButton="@id/wetButton">
                    <RadioButton
                        android:id="@+id/wetButton" style="@style/Segment"
                        android:text="@string/wet" />
                    <RadioButton
                        android:id="@+id/dryButton" style="@style/Segment"
                        android:text="@string/dry" />
                </RadioGroup>
                <LinearLayout
                    android:id="@+id/resultCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:padding="20dp"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:accessibilityLiveRegion="polite">
                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hold_object"
                        android:textColor="@color/secondary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/material"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/ink"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        android:minLines="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="invisible" />
                    <TextView
                        android:id="@+id/recommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/accent"
                        android:textSize="16sp"
                        android:minLines="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="invisible" />
                    <Button
                        android:id="@+id/actionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:textAllCaps="false"
                        android:text="@string/allow_camera"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
